
{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user's profile.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the UserProfile entity." },
        "name": { "type": "string", "description": "The user's full name." },
        "email": { "type": "string", "description": "The user's email address.", "format": "email" },
        "photoURL": { "type": "string", "description": "URL of the user's profile picture.", "format": "uri" },
        "phoneNumber": { "type": "string", "description": "The user's phone number." },
        "defaultCurrency": { "type": "string", "description": "The user's default currency code (e.g., 'USD', 'INR').", "default": "INR" },
        "isAdmin": { "type": "boolean", "default": false }
      },
      "required": ["id", "name", "email"]
    },
    "Expense": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Expense",
      "type": "object",
      "description": "Represents a personal transaction record.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "accountId": { "type": "string" },
        "categoryId": { "type": "string" },
        "tagIds": { "type": "array", "items": { "type": "string" } },
        "syncPreferences": {
          "type": "object",
          "description": "Per-wallet sync overrides (e.g., if a mirror was manually deleted).",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "disabled": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["id", "userId", "type", "amount", "date", "accountId"]
    },
    "FamilyWallet": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FamilyWallet",
      "type": "object",
      "description": "Represents a shared family ledger.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "ownerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "ownerId", "createdAt"]
    },
    "FamilyMember": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FamilyMember",
      "type": "object",
      "description": "A member within a specific family wallet.",
      "properties": {
        "userId": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "displayName": { "type": "string" },
        "joinedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "role", "joinedAt"]
    },
    "FamilyTransaction": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FamilyTransaction",
      "type": "object",
      "description": "A transaction record within a shared family ledger.",
      "properties": {
        "id": { "type": "string" },
        "walletId": { "type": "string" },
        "amount": { "type": "number" },
        "type": { "type": "string", "enum": ["expense", "income"] },
        "description": { "type": "string" },
        "categoryId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" },
        "origin": { "type": "string", "enum": ["manual", "auto"] },
        "sourceUserId": { "type": "string" },
        "sourceTransactionId": { "type": "string" }
      },
      "required": ["id", "walletId", "amount", "type", "authorId", "date", "origin"]
    },
    "AutoTag": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "AutoTag",
      "type": "object",
      "description": "A tag trigger for automatic mirroring to a wallet.",
      "properties": {
        "id": { "type": "string" },
        "tagName": { "type": "string" },
        "normalizedName": { "type": "string" },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "tagName", "normalizedName", "createdBy", "createdAt"]
    },
    "FamilyInvite": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "FamilyInvite",
      "type": "object",
      "description": "A global invite code for joining a wallet.",
      "properties": {
        "code": { "type": "string" },
        "walletId": { "type": "string" },
        "walletName": { "type": "string" },
        "role": { "type": "string", "enum": ["owner", "member"] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["code", "walletId", "role", "expiresAt", "createdBy"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous", "phone"]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profile information."
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/Expense" },
      "description": "Personal transactions."
    },
    "/users/{userId}/memberships/{walletId}": {
      "schema": { "type": "object", "properties": { "walletName": { "type": "string" }, "joinedAt": { "type": "string", "format": "date-time" } } },
      "description": "Discovery index for wallets the user belongs to."
    },
    "/familyWallets/{walletId}": {
      "schema": { "$ref": "#/entities/FamilyWallet" },
      "description": "Root document for a shared family wallet."
    },
    "/familyWallets/{walletId}/members/{userId}": {
      "schema": { "$ref": "#/entities/FamilyMember" },
      "description": "Members of the wallet."
    },
    "/familyWallets/{walletId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/FamilyTransaction" },
      "description": "The shared transaction ledger."
    },
    "/familyWallets/{walletId}/autoTags/{tagId}": {
      "schema": { "$ref": "#/entities/AutoTag" },
      "description": "Tag triggers for mirroring personal expenses."
    },
    "/invites/{inviteCode}": {
      "schema": { "$ref": "#/entities/FamilyInvite" },
      "description": "Global registry for invite codes."
    }
  }
}
