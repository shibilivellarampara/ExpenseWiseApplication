
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Private User Data ---
    // Users can only access their own user document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    // This rule allows a user to perform all actions on their own subcollections.
    // It's the key to fixing the permission errors for list, read, and write operations.
    match /users/{userId}/{collection}/{docId} {
      allow list, read, write: if isOwner(userId);
    }

    // --- Collection Group Rules ---
    // This allows for app-wide queries (e.g., across all expenses),
    // but still restricts access to only the documents owned by the user.
    match /expenses/{expenseId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    // --- Shared Data ---
    // Any signed-in user can read and modify shared expenses.
    // In a real-world app, you'd want to restrict writes to members of the space.
    match /shared_expenses/{sharedExpenseId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn(); 

      match /expenses/{expenseId} {
         allow read: if isSignedIn();
         allow create, update, delete: if isSignedIn();
      }
      
      // Allow members to read categories and tags within the shared space.
      match /categories/{categoryId} {
        allow read: if isSignedIn();
      }
      match /tags/{tagId} {
        allow read: if isSignedIn();
      }
    }
    
    // --- Admin Data ---
    // Only users with the 'isAdmin' custom claim can access the admin collection.
    match /admin/{docId} {
        allow read, write: if request.auth.token.isAdmin == true;
    }
  }
}
