
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isMember(sharedExpenseId) {
      return isSignedIn() && get(/databases/$(database)/documents/shared_expenses/$(sharedExpenseId)).data.memberIds.has(request.auth.uid);
    }

    // --- Private User Data ---
    // Users can only access their own user document.
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      // This rule allows a user to perform all actions on their own subcollections.
      match /{collection}/{docId} {
        allow list, read, write: if isOwner(userId);
      }
    }

    // --- Collection Group Rules ---
    // This allows for app-wide queries (e.g., across all expenses),
    // but still restricts access to only the documents owned by the user.
    match /expenses/{expenseId} {
       allow read, write: if request.auth.uid == resource.data.userId;
    }

    // --- Shared Data ---
    match /shared_expenses/{sharedExpenseId} {
      allow read, create: if isSignedIn();
      // Only members can update or delete a shared space
      allow update, delete: if isMember(sharedExpenseId);

      match /expenses/{expenseId} {
         // Members can read all expenses, but only create/edit/delete their own.
         allow read: if isMember(sharedExpenseId);
         allow create, update, delete: if isMember(sharedExpenseId) && request.resource.data.userId == request.auth.uid;
      }
      
      // Allow members to read and create categories and tags within the shared space.
      match /categories/{categoryId} {
        allow read, create: if isMember(sharedExpenseId);
      }
      match /tags/{tagId} {
        allow read, create: if isMember(sharedExpenseId);
      }
    }
    
    // --- Admin Data ---
    // Only users with the 'isAdmin' custom claim can access the admin collection.
    match /admin/{docId} {
        allow read, write: if request.auth.token.isAdmin == true;
    }
  }
}
