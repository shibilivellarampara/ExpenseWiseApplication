
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Private User Data ---
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if isOwner(userId);
    }
    
    // --- Family Wallets ---
    match /familyWallets/{walletId} {
      // Allow reading wallet metadata if you are a member
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      allow create: if isSignedIn();
      
      // Only owners can edit wallet metadata or delete the wallet
      allow update, delete: if isSignedIn() && get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner';

      match /members/{memberId} {
        // Base case: user can read their own membership doc (breaks recursion)
        // Other members can be read if the user themselves is a member
        allow read: if isSignedIn() && (request.auth.uid == memberId || exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)));
        
        // Members can join themselves (create), owners can manage roles (update/delete)
        allow write: if isSignedIn() && (request.auth.uid == memberId || get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner');
      }

      match /transactions/{txId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)) && 
          // Enforce origin metadata integrity
          (!('origin' in request.resource.data) || request.resource.data.origin in ['manual', 'auto']) &&
          (
            // Manual transactions must be authored by the sender
            (request.resource.data.origin == 'manual' && request.resource.data.authorId == request.auth.uid) ||
            // Auto transactions must be sourced from the sender's account
            (request.resource.data.origin == 'auto' && request.resource.data.sourceUserId == request.auth.uid)
          );
      }

      match /categories/{catId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }

      match /autoTags/{tagId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }
    }

    // --- Global Invites ---
    match /invites/{inviteCode} {
      allow read: if isSignedIn(); 
      allow create: if isSignedIn();
      allow delete: if isSignedIn();
    }
    
    // --- Collection Group Rules ---
    match /expenses/{expenseId} {
       allow read, write: if isOwner(resource.data.userId);
    }
    
    match /admin/{docId} {
        allow read, write: if request.auth.token.isAdmin == true;
    }
  }
}
