
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Family Wallets ---
    match /familyWallets/{walletId} {
      
      // Access to the wallet root is granted if you are a member
      allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      allow create: if isSignedIn();
      
      // Only owners can edit wallet metadata or delete the entire wallet
      allow update, delete: if isSignedIn() && 
        get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner';

      match /members/{memberId} {
        // STRICT BASE CASE ONLY
        allow read: if isSignedIn() && request.auth.uid == memberId;

        // Only wallet owners can manage membership documents
        allow create, update, delete: if isSignedIn() &&
          get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner';
      }

      match /transactions/{txId} {
        allow read: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
        allow write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)) && 
          // Enforce origin metadata integrity
          (!('origin' in request.resource.data) || request.resource.data.origin in ['manual', 'auto']) &&
          (
            // Manual transactions must be authored by the sender
            (request.resource.data.origin == 'manual' && request.resource.data.authorId == request.auth.uid) ||
            // Auto transactions must be sourced from the sender's account
            (request.resource.data.origin == 'auto' && request.resource.data.sourceUserId == request.auth.uid)
          );
      }

      match /categories/{catId} {
        allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }

      match /autoTags/{tagId} {
        allow read, write: if isSignedIn() && exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }
    }

    // --- Private User Data ---
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Global Invites ---
    match /invites/{inviteCode} {
      allow read: if isSignedIn(); 
      allow create, delete: if isSignedIn();
    }
    
    // --- Collection Group Rules (Required for cross-account indexing) ---
    match /expenses/{expenseId} {
       allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    match /admin/{docId} {
        allow read, write: if isSignedIn() && request.auth.token.isAdmin == true;
    }
  }
}
