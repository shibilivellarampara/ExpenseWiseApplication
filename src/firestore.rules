
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Private User Data ---
    // Users can only access their own user document and all its subcollections.
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if isOwner(userId);
    }
    
    // --- Collection Group Rules ---
    // Rule for querying the 'expenses' collection group.
    // Ensures that users can only query expenses they own.
    match /expenses/{expenseId} {
       allow read, write: if isOwner(resource.data.userId);
    }
    
    // --- Shared Data ---
    match /shared_ledgers/{ledgerId} {
      // Any member can read the main ledger document.
      allow get: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Allow a user to list ledgers they are a member of.
      allow list: if isSignedIn() && request.auth.uid == request.query.where.memberIds[2];
      
      // Any authenticated user can create a new shared ledger.
      allow create: if isSignedIn();
      
      // Only the owner can update the ledger name or add/remove members.
      allow update: if isSignedIn() && request.auth.uid == resource.data.ownerId;
      
      // No one can delete a shared ledger directly to prevent accidental data loss.
      allow delete: if false;
    }
    
    match /shared_transactions/{transactionId} {
      allow read, write: if isSignedIn();
    }
    match /shared_categories/{categoryId} {
      allow read, write: if isSignedIn();
    }
    match /shared_tags/{tagId} {
      allow read, write: if isSignedIn();
    }
    
    // --- Admin Data ---
    // Only users with the 'isAdmin' custom claim can access the admin collection.
    match /admin/{docId} {
        allow read, write: if request.auth.token.isAdmin == true;
    }
  }
}
