rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // --- Family Wallets ---
    match /familyWallets/{walletId} {
      
      // Access to the wallet root
      allow read: if request.auth != null && 
        exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      
      allow create: if request.auth != null;
      
      // Only owners can edit wallet metadata
      allow update, delete: if request.auth != null && 
        get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner';

      match /members/{memberId} {
        // STRICT BASE CASE ONLY - Allows exists() to resolve without recursion
        allow read: if request.auth != null && request.auth.uid == memberId;

        // Management restricted to owners
        allow create, update, delete: if request.auth != null &&
          get(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)).data.role == 'owner';
      }

      match /transactions/{txId} {
        allow read: if request.auth != null && 
          exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
        
        allow write: if request.auth != null && 
          exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid)) && 
          (!('origin' in request.resource.data) || request.resource.data.origin in ['manual', 'auto']) &&
          (
            (request.resource.data.origin == 'manual' && request.resource.data.authorId == request.auth.uid) ||
            (request.resource.data.origin == 'auto' && request.resource.data.sourceUserId == request.auth.uid)
          );
      }

      match /categories/{catId} {
        allow read, write: if request.auth != null && 
          exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }

      match /autoTags/{tagId} {
        allow read, write: if request.auth != null && 
          exists(/databases/$(database)/documents/familyWallets/$(walletId)/members/$(request.auth.uid));
      }
    }

    // --- Private User Data ---
    match /users/{userId}/{allSubcollections=**} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Global Invites ---
    match /invites/{inviteCode} {
      allow read: if isSignedIn(); 
      allow create, delete: if isSignedIn();
    }
    
    // --- Collection Group Rules (Required for cross-account indexing) ---
    match /expenses/{expenseId} {
       allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    match /admin/{docId} {
        allow read, write: if isSignedIn() && request.auth.token.isAdmin == true;
    }
  }
}